#cloud-config
# T2 first-boot provisioning.
#
# The cloud image is customised on first boot rather than by mounting and
# chrooting it, which keeps the whole build runnable from macOS with nothing but
# qemu, and keeps the customisation a readable list instead of a shell script
# operating on someone else's filesystem.

hostname: afos
preserve_hostname: false

# No users. Not "a user with no password" -- none. The break-glass agetty
# autologins root on the serial console, and that is the entire login story.
users: []
disable_root: false
ssh_pwauth: false

# A key for root -- which is safe precisely because ForceCommand makes an
# ssh login land in the agent console and nothing else. This is the shape a
# real cloud already has (the provider injects its own key here), so the
# acceptance run tests the real configuration rather than an emptier one.
ssh_authorized_keys:
  - @TEST_SSH_KEY@

# bootcmd runs in cloud-init's init stage, which is far earlier than runcmd --
# early enough to matter, because getty.target is reached within seconds of boot
# and runcmd does not happen until provisioning is nearly over. Without this the
# provisioning boot really does print "afos login:" on the serial console and
# leave it there for ten seconds, which is the one thing this project exists to
# remove. It runs on every boot, which also makes it a backstop if a future
# change ever un-masks a getty.
bootcmd:
  # The TEMPLATES, not instances. Masking getty@tty1 leaves getty@tty2 alone,
  # and logind autospawns it the moment someone presses Ctrl-Alt-F2 -- a login
  # prompt on a machine that is not supposed to have one. Masking getty@.service
  # covers every instance, named or not.
  - [sh, -c, "systemctl mask getty@.service serial-getty@.service getty-static.service autovt@.service 2>/dev/null || true"]
  - [sh, -c, "systemctl stop 'getty@*' 'serial-getty@*' 2>/dev/null || true"]

write_files:
  - path: /etc/systemd/system/afosd.service
    content: |
@AFOSD_SERVICE@
  - path: /etc/systemd/system/afos-console@.service
    content: |
@AFOS_CONSOLE_SERVICE@
  - path: /etc/systemd/system/afos-rescue.target
    content: |
@AFOS_RESCUE_TARGET@
  - path: /etc/systemd/system/afos-breakglass.service
    content: |
@AFOS_BREAKGLASS_SERVICE@
  - path: /etc/systemd/system/afos-escalate@.service
    content: |
@AFOS_ESCALATE_SERVICE@
  - path: /etc/systemd/logind.conf.d/afos.conf
    content: |
@LOGIND_CONF@
  - path: /etc/ssh/sshd_config.d/00-afos.conf
    permissions: '0644'
    content: |
@SSHD_CONF@
  - path: /usr/local/bin/afos-update
    permissions: '0755'
    content: |
@AFOS_UPDATE@
  - path: /opt/afos/packages.keep
    content: |
@PACKAGES_KEEP@
  - path: /opt/afos/packages.purge
    content: |
@PACKAGES_PURGE@

  # Launchers instead of `pip install`. The cloud image ships no pip, and
  # adding one would mean shipping setuptools and its dependency tree on a
  # system whose whole premise is subtraction. Two four-line scripts and a
  # directory on sys.path do the same job with nothing left behind.
  - path: /usr/local/bin/afosd
    permissions: '0755'
    content: |
      #!/usr/bin/python3
      import sys
      sys.path.insert(0, "/opt/afos/lib")
      from afos.daemon import main
      sys.exit(main())
  - path: /usr/local/bin/afos-console
    permissions: '0755'
    content: |
      #!/usr/bin/python3
      import sys
      sys.path.insert(0, "/opt/afos/lib")
      from afos.client import main
      sys.exit(main())

  - path: /opt/afos/agent.tar.gz
    encoding: b64
    content: @AGENT_TARBALL_B64@

runcmd:
  # 1. Install the agent.
  # Versioned from the first boot, so an update is a symlink move rather
  # than an in-place overwrite of the directory the agent is running from.
  - [sh, -c, "mkdir -p /opt/afos/versions/seed && tar -xzf /opt/afos/agent.tar.gz -C /opt/afos/versions/seed"]
  - [sh, -c, "ln -sfn versions/seed /opt/afos/lib"]
  - [groupadd, -f, afos]
  - [sh, -c, "/usr/local/bin/afosd --help >/dev/null || { echo 'afos: agent does not run'; exit 1; }"]

  # 2. Find the serial console. It is ttyAMA0 on arm64 virt and ttyS0 on amd64;
  #    hardcoding whichever one the author happened to boot leaves a getty --
  #    and therefore a login prompt -- alive on the other architecture.
  - [sh, -c, "echo AFOS_SERIAL=$(awk 'NR==1{print $1}' /proc/consoles) > /run/afos-serial.env; cat /run/afos-serial.env"]

  # 3. Subtract every interactive entry that is not the agent. Masked, not
  #    disabled: the difference between "not started" and "cannot be started".
  - [sh, -c, "systemctl mask getty@.service serial-getty@.service getty-static.service autovt@.service"]
  # The logind drop-in only takes effect when logind reads it. Without this,
  # NAutoVTs=0 is true from the *second* boot -- and the provisioning boot,
  # the one everything is verified on, still autospawns virtual terminals.
  - [sh, -c, "systemctl restart systemd-logind.service 2>/dev/null || true"]
  # Masking does not stop a unit that is already running, and getty.target is
  # reached long before cloud-init gets here -- so without this the first boot
  # really does serve a human login prompt on tty1 for the life of that boot,
  # which is the single thing afos exists to remove. Stop every getty that got
  # started, not just the ones this template can name.
  - [sh, -c, "systemctl stop 'getty@*' 'serial-getty@*' 2>/dev/null || true"]
  - [sh, -c, "pkill -f '^/sbin/agetty' 2>/dev/null || true"]
  - [sh, -c, "systemctl disable getty.target || true"]

  # 4. Point break-glass at the console that actually exists on this machine.
  - [sh, -c, ". /run/afos-serial.env; mkdir -p /etc/systemd/system/afos-breakglass.service.d; printf '[Service]\\nExecStart=\\nExecStart=/sbin/agetty --autologin root --noclear %s 115200 vt220\\nTTYPath=/dev/%s\\n' \"$AFOS_SERIAL\" \"$AFOS_SERIAL\" > /etc/systemd/system/afos-breakglass.service.d/console.conf"]

  # 5. Make ssh a frontend rather than a bypass. Without this, the provider's
  #    key in /root/.ssh/authorized_keys is a root shell on port 22 that never
  #    touches the agent -- which would make the project's central claim false
  #    on every real cloud, while every check in T2 still passed.
  # /run/sshd is created by ssh.service, which socket activation means has
  # never run yet -- so `sshd -t` fails with "Missing privilege separation
  # directory" and the config is never validated.
  - [sh, -c, "mkdir -p /run/sshd && sshd -t"]
  - [sh, -c, "systemctl reload ssh 2>/dev/null || true"]

  # 6. Install the agent as the replacement.
  - [systemctl, daemon-reload]
  - [systemctl, enable, afosd.service]
  - [sh, -c, ". /run/afos-serial.env; systemctl enable \"afos-console@$AFOS_SERIAL.service\" afos-console@tty1.service"]

  # 7. Remove the leftovers now that provisioning is done with them.
  - [sh, -c, "apt-get -y purge $(grep -vE '^\\s*(#|$)' /opt/afos/packages.purge | tr '\\n' ' ') 2>/dev/null || true"]
  - [sh, -c, "apt-get -y autoremove --purge && apt-get clean"]

  # The purge list says what goes; this says what must survive it. autoremove
  # is unattended and operates on a package set the purge has already
  # destabilised, so "nothing important was taken" needs checking, not hoping.
  - [sh, -c, "for pkg in $(grep -vE '^\\s*(#|$)' /opt/afos/packages.keep); do dpkg -s \"$pkg\" >/dev/null 2>&1 || { echo \"afos: purge removed a required package: $pkg\" >&2; touch /run/afos-provision-failed; }; done"]
  - [sh, -c, "/usr/local/bin/afosd --help >/dev/null 2>&1 || { echo 'afos: the agent does not run after provisioning' >&2; touch /run/afos-provision-failed; }"]

  # 8. Hand over the console without a reboot, so the first boot shows the real
  #    thing rather than the second.
  - [systemctl, start, afosd.service]
  - [sh, -c, ". /run/afos-serial.env; systemctl start \"afos-console@$AFOS_SERIAL.service\""]

  # Say what actually happened. The previous message announced success
  # unconditionally, including on the boot where the agent could not start.
  - [sh, -c, "if [ -e /run/afos-provision-failed ]; then echo 'afos: PROVISIONING FAILED -- see the messages above' >&2; else echo 'afos: provisioning verified'; fi"]

final_message: "afos provisioning finished in $UPTIME seconds -- see 'provisioning verified' above for the verdict"
