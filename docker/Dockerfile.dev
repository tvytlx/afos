# T0 -- the inner loop. Not a model of the real system: a container has no boot,
# no tty1 and no display manager to remove. What it does give you is the exact
# userspace afosd runs in, in about a second.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        ca-certificates \
        procps \
        iproute2 \
        iputils-ping \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Ubuntu 24.04 marks the system Python as externally managed; afos is the only
# Python on this system, so there is nothing to protect it from.
ENV PIP_BREAK_SYSTEM_PACKAGES=1 \
    PYTHONUNBUFFERED=1 \
    AFOS_SOCKET=/run/afos/afosd.sock

WORKDIR /opt/afos
COPY agent/pyproject.toml /opt/afos/agent/pyproject.toml
COPY agent/afos /opt/afos/agent/afos
RUN pip install --no-cache-dir -e /opt/afos/agent && mkdir -p /run/afos

COPY docker/entrypoint.sh /usr/local/bin/afos-dev
RUN chmod +x /usr/local/bin/afos-dev

ENTRYPOINT ["/usr/local/bin/afos-dev"]
