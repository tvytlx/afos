[Unit]
Description=afos agent daemon
Documentation=https://github.com/tvytlx/afos
# Deliberately NOT ordered after network-online.target. afosd binds a Unix
# socket and needs no network to serve a console -- and the only interactive
# entry on the machine must not be gated on DHCP. A brain that needs the
# network handles its absence at call time, not by delaying the console.
After=basic.target
# Absorb crashes, surrender only when the daemon cannot stay up at all.
# Five failures in a minute is not transient; below that, Restart= handles it.
# The escalation is conditional, which is why it goes through a helper unit
# rather than OnFailure=afos-rescue.target -- see afos-escalate@.service.
StartLimitIntervalSec=60
StartLimitBurst=5
OnFailure=afos-escalate@afosd.service

[Service]
# /usr/local/bin, not /usr/bin: afos installs with pip today. This moves to
# /usr/bin the moment it ships as a package -- and until then, pointing the
# unit at a path nothing installs to just yields 203/EXEC at boot.
Type=exec
ExecStart=/usr/local/bin/afosd
RuntimeDirectory=afos
RuntimeDirectoryMode=0755
Restart=always
RestartSec=1
KillMode=mixed
TimeoutStopSec=10
# A bounded cgroup failure with a journal entry, rather than a machine-wide
# OOM. afosd is the only way into this box, so 'the daemon died' and 'the
# kernel picked a victim' are the difference between a restart and a brick.
#
# Deliberately NO MemoryHigh. MemoryHigh throttles rather than failing: past
# it the kernel reclaims harder and harder and the process crawls, forever,
# with no error and no kill. Measured on a 2GB machine with MemoryHigh=256M:
# a 200MB allocation returned instantly, a 400MB one never returned at all
# (memory.events showed 5300 throttle events, oom_kill 0). Everything the
# agent runs shares this cgroup, so that ceiling was the agent's ceiling --
# `apt upgrade` would simply hang.
#
# A percentage, not a number: the right cap on a 1GB VM is not the right cap
# on a 64GB host, and a hardcoded one is wrong on both.
MemoryMax=50%
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
